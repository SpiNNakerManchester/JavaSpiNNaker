# The path to where complete data files should be stored
DATA_PATH=/mnt/data

# The Group ID of the docker user (found from "getent group docker")
DOCKER_GROUP_ID=998

# The location of the execute_pynn script to run in each job
EXECUTE_PYNN = /home/nmpi/JavaSpiNNaker/SpiNNaker-nmpiserv/execute_pynn.bash

# The location of the NMPI properties file (see nmpi.properties.example in this repository)
NMPI_PROPERTIES = /home/nmpi/nmpi.properties
