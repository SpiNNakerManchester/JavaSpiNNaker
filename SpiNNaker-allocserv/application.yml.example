spalloc:
  working-directory: /app
  auth:
    add-dummy-user: false
    dummy-random-pass: false
    openid:
      introspection-uris:
        hbp-ebrains:
          type: spring
          uri: https://iam.ebrains.eu/auth/realms/hbp/protocol/openid-connect/token/introspect
          username_property: preferred_username
        google:
          type: token
          uri: https://oauth2.googleapis.com/tokeninfo
          username_property: email
          token_parameter: access_token
  sqlite:
    performance-log: true
  compat:
    enable: true
    host: 0.0.0.0
    port: 22244
    # This user and group needs to be created
    service-user: ${SPALLOC_COMPAT_USER}
    service-group: ${SPALLOC_COMPAT_GROUP}
  transceiver:
    period: 3s
    # dummy: true
  datasource:
    jdbc-url: ${SPRING_DATASOURCE_URL}
    username: ${SPRING_DATASOURCE_USERNAME}
    password: ${SPRING_DATASOURCE_PASSWORD}
  allocator:
    importance-span: 1200
    emergencyStopCommandCode: ${SPALLOC_EMERGENCY_STOP_CODE}
  historical-data:
    datasource:
      jdbc-url: ${SPRING_HISTORICAL_DATASOURCE_URL}
      username: ${SPRING_DATASOURCE_USERNAME}
      password: ${SPRING_DATASOURCE_PASSWORD}
  quota:
    nmpi-url: https://nmpi-v3.hbpneuromorphic.eu/
    nmpi-api-key: ${SPALLOC_NMPI_API_KEY}
    nmpi-platform: SpiNNaker
  proxy:
    local-host: 0.0.0.0

server:
  port: 9091

logging:
  file:
    name: spalloc.log
    path: ${spalloc.working-directory}
  level:
    root: INFO

spring:
  mvc:
    servlet:
      path: /spalloc
  security:
    oauth2:
      client:
        registration:
          hbp-ebrains:
            client-name: HBP / EBRAINS
            client-id: ${OIDC_EBRAINS_CLIENT_ID}
            client-secret: ${OIDC_EBRAINS_CLIENT_SECRET}
            redirect-uri: https://spinnaker.cs.man.ac.uk/spalloc/system/perform_oidc/{action}/code/{registrationId}
          google:
            client-name: Google
            client-id: ${OIDC_GOOGLE_CLIENT_ID}
            client-secret: ${OIDC_GOOGLE_CLIENT_SECRET}
            redirect-uri: https://spinnaker.cs.man.ac.uk/spalloc/system/perform_oidc/{action}/code/{registrationId}

cxf:
  path: /spalloc/srv
